{
  "proxy": "",
  "terminal": {
    "starts_open": false,
    "shell": {
      "program": "/usr/bin/fish"
    }
  },
  "project_panel": {
    "scrollbar": {
      "show": "never"
    }
  },
  "status_bar": {
    "show_active_file": false
  },
  "scrollbar": {
    "show": "never"
  },
  "agent_ui_font_family": "Atkinson Hyperlegible Mono",
  "agent_buffer_font_family": "Hack",
  "agent_ui_font_size": 15.0,
  "ui_font_family": "Atkinson Hyperlegible Mono",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "Atkinson Hyperlegible Mono",
  "icon_theme": "Icons modern material (Dark)",
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": "Vercel Dark",
  "theme_overrides": {
    "Vercel Dark": {
      "background": "#0C1115",
      "text": "#FFFFFF",
      "panel.background": "#0A0E11",
      "status_bar.background": "#0A0E11",
      "title_bar.background": "#0A0E11",
      "title_bar.inactive_background": "#0A0E11",
      "toolbar.background": "#0C1115",
      "border": "#2E343C",
      "scrollbar.thumb.background": "#00000000",
      "scrollbar.thumb.hover_background": "#00000000",
      "scrollbar.thumb.border": "#00000000",
      "editor.background": "#0C1115",
      "editor.foreground": "#FFFFFF",
      "editor.gutter.background": "#0C1115",
      "editor.line_number": "#404A55",
      "editor.active_line_number": "#FFFFFF",
      "editor.active_line.background": "#2E343C22",
      "tab_bar.background": "#0A0E11",
      "tab.inactive_background": "#0A0E11",
      "tab.active_background": "#6C6C6C",
      "players": [
        {
          "selection": "#BD2523"
        }
      ],
      "syntax": {
        "comment": { "color": "#778397" },
        "string": { "color": "#FB9435" },
        "keyword": { "color": "#BD0F2F" },
        "function": { "color": "#49E998" },
        "type": { "color": "#FDDF6E" },
        "number": { "color": "#EA4727" },
        "property": { "color": "#2A8BC1" },
        "operator": { "color": "#A0B6D3" }
      }
    }
  }
