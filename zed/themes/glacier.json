{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Glacier",
  "author": "Joey Figaro",
  "themes": [
    {
      "name": "Glacier",
      "appearance": "dark",
      "style": {
        "background": "#0C1218",
        "text": "#C1C8BD",
        "panel.background": "#090D12",
        "status_bar.background": "#070A0E",
        "title_bar.background": "#070A0E",
        "border": "#1A2633",
        "editor.background": "#0C1218",
        "editor.foreground": "#C1C8BD",
        "editor.line_number": "#34495E",
        "editor.active_line_background": "#141D26",
        "syntax": {
          "comment": { "color": "#515C68", "font_style": "italic" },
          "string": "#A1555E",
          "keyword": "#52AEBA",
          "function": "#C7B568",
          "type": "#F7F297",
          "number": "#E18942",
          "property": "#52AEBA",
          "operator": "#C1C8BD"
        }
      }
    }
  ]
}
